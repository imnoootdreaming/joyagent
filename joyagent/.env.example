# === Anthropic API ===
ANTHROPIC_API_KEY=your Anthropic API key here

# DeepSeek 兼容端点（使用 DeepSeek 模型时设置此值）
ANTHROPIC_BASE_URL=your DeepSeek API endpoint here

# === 默认模型 ===
DEFAULT_MODEL=your default model here

# === 备选模型（529 过载时自动切换） ===
# FALLBACK_MODEL=your fallback model here

# === Embedding / 向量库（Phase 6 + RAG） ===
# 本地离线模型目录（Docker 内为 /models/all-MiniLM-L6-v2）
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# ChromaDB 持久化目录（默认 ./data/chroma）
# CHROMA_PERSIST_DIR=./data/chroma

# === RAG 知识库 ===
# 总开关：false 时 /api/chat 的 use_rag 参数被忽略（运维降级用）
# RAG_ENABLED=true
# 默认知识库集合名（预留多知识库能力）
# RAG_COLLECTION=knowledge
# 切分参数（字符数）
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120
# 检索参数
# RAG_TOP_K=4
# RAG_SCORE_THRESHOLD=0.3
# 注入 prompt 的上下文总长度上限
# RAG_MAX_CONTEXT_CHARS=6000
# 目录导入白名单（分号分隔绝对路径前缀，留空 = 不限制）
# RAG_ALLOWED_DIRS=/workspace/docs;/mnt/hgfs/joyagent
